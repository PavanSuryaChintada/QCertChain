{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/certstream/Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "multiRegionConfig": {
      "asia-southeast1-eqsg3a": {
        "numReplicas": 1
      }
    }
  }
}
