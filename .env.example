# QCertChain environment. Copy to .env and fill in. NEVER commit .env; this file holds no real secret.
# Python settings are read by services/config.py (env var first, then .env). Empty = use the default.
# "Needs" names the service(s) that read the variable: api, ingest, triage, enrich, anchor (the workers
# share the API image), console (Vite, build time), scripts, tests, docs (shell convenience only).

# ---------------------------------------------------------------- database (Supabase, ap-southeast-1)
# App database, session pooler (IPv4), SQLAlchemy form: postgresql+psycopg://postgres.<ref>:<pw>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Default: empty (API answers /health as degraded; workers exit "DATABASE_URL is not set"). Needs: api, all workers, scripts.
DATABASE_URL=
# Direct (non-pooler) connection for migrations / pg_dump: postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
# Default: none. Needs: scripts/apply_schema.py, backups (docs/MIGRATION_RUNBOOK.md) only.
DATABASE_URL_DIRECT=
# Test database (docker compose --profile test up -d postgres-test). Default: postgresql+psycopg://qcertchain:qcertchain@localhost:5433/qcertchain_test. Needs: tests.
TEST_DATABASE_URL=
# Pool size / overflow per process. Defaults: 5 / 5. Needs: api, workers.
DB_POOL_SIZE=5
DB_POOL_OVERFLOW=5

# ---------------------------------------------------------------- Supabase project (management only; the app uses DATABASE_URL)
# Project ref (the <ref> in the URLs above). Needs: docs / supabase CLI.
SUPABASE_PROJECT_REF=
# https://<ref>.supabase.co. Needs: docs / manual REST checks only.
SUPABASE_URL=
# Publishable (anon) key; RLS denies it everything by design. Needs: manual RLS check only.
SUPABASE_PUBLISHABLE_KEY=
# Personal access token for the supabase CLI / management API. SECRET. Needs: owner tooling only.
SUPABASE_ACCESS_TOKEN=
# Database password (the <pw> above). SECRET. Needs: building DATABASE_URL / DATABASE_URL_DIRECT.
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------- queue
# Redis Streams. Default: redis://localhost:6379. Railway: ${{Redis.REDIS_URL}}. Needs: api, ingest, triage, enrich, anchor.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- Certificate Transparency
# Self-hosted certstream-server-go. Default: ws://localhost:8080/. Railway: ws://certstream.railway.internal:8080/. Needs: ingest.
CERTSTREAM_URL=ws://localhost:8080/
# live | replay. Default: live. Needs: ingest.
STREAM_MODE=live
# Replay fixture. Default: data/capture.jsonl. Needs: ingest (replay mode).
REPLAY_FILE=data/capture.jsonl
# Replay speed multiplier. Default: 1.0. Needs: ingest.
REPLAY_SPEED=1.0
# Raw certificate retention in hours. Default: 24. Needs: triage.
RAW_CERT_RETENTION_H=24

# ---------------------------------------------------------------- triage (docs/MODELS.md)
# Candidate threshold. Default: 0.35 (owner decision, 2026-10-07). Needs: triage, api.
TRIAGE_THRESHOLD=0.35
# Trained model. Default: services/ml/artifacts/triage_lr.joblib (falls back to rules if absent). Needs: triage, api.
TRIAGE_MODEL_PATH=services/ml/artifacts/triage_lr.joblib
# Brand list. Default: data/brands.yaml. Needs: triage, enrich, api.
BRANDS_FILE=data/brands.yaml
# Tranco allowlist (regenerated by scripts/fetch_allowlist.py; baked into the image). Default: data/allowlist.txt. Needs: triage, api.
ALLOWLIST_FILE=data/allowlist.txt

# ---------------------------------------------------------------- enrichment / confirmation
# S1 credential-exfiltration signal (Telegram bot / Discord webhook / mail or form relay API on a password page).
# off | moderate | strong. Default: strong (S3 false-positive gate: 0 FP). Needs: enrich.
# Runtime kill switch without a redeploy: POST /admin/signals {"exfil":"off"} (can only lower, never raise).
EXFIL_SIGNAL_STRENGTH=strong
# S2 credential POST to a foreign site, read from the page's own code. off | moderate | strong. Default: moderate
# (held-out S3 gate: 1 false positive, a legitimate feature-flag POST on twitch.tv; owner rule: any FP -> moderate). Needs: enrich.
JS_POST_SIGNAL_STRENGTH=moderate
# Page-fetch timeout in seconds. Default: 15.0. Needs: enrich.
CONFIRM_TIMEOUT_S=15
# Concurrent confirmations. Default: 4. Needs: enrich.
ENRICH_WORKERS=4
# Minimum seconds between fetches to one host. Default: 2.0. Needs: enrich.
PER_HOST_RATE_LIMIT_S=2.0
# Scanner User-Agent; put a real contact address. Default: QCertChain-Scanner/0.1 (phishing research). Needs: enrich.
USER_AGENT=QCertChain-Scanner/0.1 (phishing research; contact: <owner email>)
# Org on whose behalf public-feed candidates are confirmed. Default: org1. Needs: enrich, scripts.
PIPELINE_ORG=org1

# ---------------------------------------------------------------- graph + interdiction (docs/NPHARD.md)
# Campaign edge threshold; do NOT lower it to inflate campaigns. Default: 0.6. Needs: api, enrich.
CLUSTER_EDGE_THRESHOLD=0.6
# Default takedown budget k. Default: 5. Needs: api.
INTERDICT_BUDGET_K=5
# cpsat | qaoa | annealing | greedy. Default: cpsat (NOT qaoa). Needs: api.
INTERDICT_BACKEND=cpsat
# Largest QUBO sent to QAOA (Aer statevector dies above this). Default: 24. Needs: api.
MAX_QUBO_VARIABLES=24

# ---------------------------------------------------------------- evidence
# Evidence bundle directory. Default: data/evidence. Railway: /data/evidence on a volume. Needs: api, enrich.
EVIDENCE_DIR=data/evidence
# Ed25519 signing key, hex; generate with python -m scripts.genkey. SECRET. Default: empty (enrich refuses to start without it). Needs: api, enrich.
COLLECTOR_PRIVATE_KEY=

# ---------------------------------------------------------------- chain (Hardhat demo consortium)
# Demo chain RPC. Default: http://localhost:8545. Railway: http://hardhat.railway.internal:8545. Needs: api, anchor.
CHAIN_RPC=http://localhost:8545
# Test chain (a separate node, so tests never write to the demo chain). Default: http://127.0.0.1:8546. Needs: tests.
TEST_CHAIN_RPC=http://127.0.0.1:8546
# Hardhat account #1 = org1 "Bank One SOC" (account #0 is the admin, NOT an org). Public test key; never use on a real chain. Needs: api, anchor.
ORG_PRIVATE_KEY=
# Hardhat account #2 = org2 "Bank Two SOC". Needs: api, anchor.
ORG2_PRIVATE_KEY=
# Contract addresses are NOT configured here: services/api/ledger_service.py reads contracts/deployments/localhost.json.

# ---------------------------------------------------------------- API access + rate limits
# Requests per minute per key, by kind (429 + Retry-After above). Defaults: 60 / 600 / 60. Needs: api.
RATE_LIMIT_DEMO=60
RATE_LIMIT_ORG=600
RATE_LIMIT_ADMIN=60
# Comma-separated CORS origins for the console. Default: http://localhost:5180. Railway: https://<app>.vercel.app. Needs: api.
CONSOLE_ORIGINS=http://localhost:5180
# Region label shown by GET /health. Default: RAILWAY_REPLICA_REGION (set by Railway), else "local". Needs: api (optional).
API_REGION=
# Set automatically by Railway (e.g. asia-southeast1-eqsg3a); do not set by hand. Needs: api (read only).
# RAILWAY_REPLICA_REGION=

# ---------------------------------------------------------------- console (Vite, baked in at build time; Vercel project variables)
# API base URL. Default: http://localhost:8000. Needs: console.
VITE_API_URL=http://localhost:8000
# Optional pre-filled key. Use ONLY the read-only demo key, or leave empty (the console asks). Needs: console.
VITE_API_KEY=

# ---------------------------------------------------------------- shell conveniences (docs/RUNBOOK.md, docs/DEMO.md curl examples)
# Tokens printed by python -m scripts.create_api_key. Not read by any service. SECRET (except the demo key).
QCC_KEY_ORG1=
QCC_KEY_ORG2=
QCC_KEY_DEMO=
QCC_KEY_ADMIN=
