# QCertChain — copy to .env and adjust. Never commit .env.

DATABASE_URL=postgresql+psycopg://qcertchain:qcertchain@localhost:5432/qcertchain
REDIS_URL=redis://localhost:6379

# --- Certificate Transparency ---
CERTSTREAM_URL=wss://certstream.calidog.io/
STREAM_MODE=live                 # live | replay
REPLAY_FILE=data/capture.jsonl
REPLAY_SPEED=1.0

# --- Triage (docs/MODELS.md) ---
TRIAGE_THRESHOLD=0.45
TRIAGE_MODEL_PATH=services/ml/artifacts/triage_lr.joblib
BRANDS_FILE=data/brands.yaml
ALLOWLIST_FILE=data/allowlist.txt

# --- Enrichment ---
CONFIRM_TIMEOUT_S=15
ENRICH_WORKERS=4
PER_HOST_RATE_LIMIT_S=2.0
USER_AGENT=QCertChain-Scanner/0.1 (phishing research; contact: team@example.edu)

# --- Graph ---
CLUSTER_EDGE_THRESHOLD=0.6       # do NOT lower this to inflate campaign size

# --- Interdiction (docs/NPHARD.md) ---
INTERDICT_BUDGET_K=5
INTERDICT_BACKEND=cpsat          # NOT qaoa by default
MAX_QUBO_VARIABLES=24            # Aer statevector dies above this

# --- Evidence ---
EVIDENCE_DIR=/data/evidence
COLLECTOR_PRIVATE_KEY=           # ed25519 hex; generate with scripts/genkey.py

# --- Chain ---
CHAIN_RPC=http://localhost:8545
ORG_PRIVATE_KEY=                 # hardhat account #0 for local dev
ORG2_PRIVATE_KEY=                # hardhat account #1 — the second organisation
CONTRACT_ORG_REGISTRY=
CONTRACT_CAMPAIGN_REGISTRY=
CONTRACT_EVIDENCE_ANCHOR=

# --- Retention ---
RAW_CERT_RETENTION_H=24
